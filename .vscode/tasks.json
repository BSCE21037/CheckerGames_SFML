{
    "version": "2.0.0",
    "tasks": [
        {
            "type": "shell",
            "label": "build checkers",
            "command": "make",
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "problemMatcher": [
                "$gcc"
            ],
            "group": {
                "kind": "build",
                "isDefault": true
            },
            "detail": "Builds the game via the cross-platform Makefile."
        },
        {
            "type": "shell",
            "label": "run checkers",
            "command": "make run",
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "problemMatcher": [
                "$gcc"
            ],
            "detail": "Builds and launches the game (cwd = project root, so assets resolve)."
        }
    ]
}
